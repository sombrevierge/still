{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Still",
  "version": "0.4.6",
  "identifier": "com.catherine.still",
  "build": {
    "beforeDevCommand": "pnpm build:sensors && pnpm dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "pnpm build:all",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Still",
        "width": 1240,
        "height": 820,
        "minWidth": 980,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#f3f3f0"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../sensor-helper/publish-bundled/": "sensor-helper/"
    },
    "category": "Utility",
    "shortDescription": "Actively lighten and maintain the current Windows session",
    "longDescription": "Still is a local-first Windows optimizer with verified process actions, adaptive memory and priority balancing, and recoverable storage cleanup.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    }
  }
}
